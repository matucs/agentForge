# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# Host ports 5433/6380 are used (not 5432/6379) to avoid clashing with any
# other Postgres/Redis already running on your machine. Compose maps these
# to the containers' standard 5432/6379 internally.
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5433/agentforge
REDIS_URL=redis://localhost:6380/0

# LLM provider abstraction — set the keys for whichever provider(s) you want
# to actually call. Absent keys mean that provider reports "unavailable",
# never a mocked response.
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: enables real GitHub branch/PR automation (Phase 7). Absent =
# local/demo git mode only.
GITHUB_TOKEN=
GITHUB_REPO=

# Optional: outbound webhook notifications on run completion/approval-
# required (Phase 11). Absent = logged no-op, no delivery attempted.
N8N_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional observability integrations (Phase 8). Absent = local fallback only.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentforge
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cost / iteration guardrails
MAX_AGENT_ITERATIONS=6
MAX_WORKFLOW_SECONDS=900
MAX_RUN_BUDGET_USD=2.00
